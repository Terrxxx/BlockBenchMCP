{
  "name": "blockbench-ai-mcp",
  "version": "0.7.1",
  "private": true,
  "description": "A workspace-scoped MCP bridge for the Blockbench desktop application",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "tsx scripts/setup.ts",
    "start": "node dist/server/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:exports": "tsx scripts/smoke-exports.ts",
    "smoke:render": "tsx scripts/smoke-render.ts",
    "smoke:modeling": "tsx scripts/smoke-modeling.ts",
    "smoke:multi-session": "tsx scripts/smoke-multi-session.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "blockbench-types": "5.2.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "author": "Terrxx",
  "license": "MIT"
}
