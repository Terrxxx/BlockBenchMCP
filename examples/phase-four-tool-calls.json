{
  "instructions": "使用本会话创建的活动 Bedrock 工程，替换实际 ID。models 目录须存在，示例路径不得已被占用；覆盖必须显式 overwrite:true。",
  "calls": [
    { "name": "export_bedrock_model", "arguments": { "project_id": "<project_id>", "path": "models/entity.geo.json" } },
    { "name": "export_bedrock_animations", "arguments": { "project_id": "<project_id>", "animation_ids": ["<animation_id_1>", "<animation_id_2>"], "path": "models/entity.animation.json" } },
    { "name": "export_texture_png", "arguments": { "project_id": "<project_id>", "texture_id": "<texture_id>", "path": "models/entity.png" } }
  ]
}
