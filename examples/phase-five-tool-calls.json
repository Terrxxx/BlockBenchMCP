    { "name": "render_project", "arguments": { "project_id": "<project_id>", "path": "models/render_animated.png", "camera": { "projection": "perspective", "position": [40,28,48], "target": [0,8,0] }, "animation": { "animation_id": "<animation_id>", "time": 0.5 } } },
    { "name": "render_project", "arguments": { "project_id": "<project_id>", "path": "models/render_top.png", "camera": { "projection": "orthographic", "position": [0,64,0], "target": [0,8,0], "up": [0,0,-1], "vertical_size": 32 }, "background": "#102030" } }
